<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Version>0.1.5</Version>
    <AssemblyVersion>0.1.5.0</AssemblyVersion>
    <FileVersion>0.1.5.0</FileVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>P2PKiwi.WinUI3</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\TokiCast.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <!-- Windows App SDK 1.6：WinUI 3 + Mica / NavigationView 等 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- WebRTC：SIPSorcery 8.0.23（.NET 8 线；8.3.1 不存在，不要写）。
      远端音频接收走 RTPSession.OnAudioFrameReceived（Phase 0 已验证事件存在）；
      MLS/SFrame 不在 SIPSorcery 里，E2EE 开关只存值、不接线、不亮徽标。 -->
    <PackageReference Include="SIPSorcery" Version="8.0.23" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="8.0.12" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="8.0.14" />
    <!-- 视频编解码 H.264：FFmpeg 7.x 共享 DLL 随安装包放在 exe 旁边（见发布说明），不要打进包里。 -->
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="8.0.12" />
    <!-- 屏幕采集：Win2D 共享 D3D 设备（GraphicsCapture 的标准做法）。 -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>
</Project>
