<Page
    x:Class="P2PKiwi.WinUI3.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid ColumnDefinitions="*,320" Padding="16">
        <!-- 投屏画面：MediaPlayerElement 接 WebRTC 远端视频轨；本地分享时显示采集预览 -->
        <Grid Grid.Column="0" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <!-- 远端画面占位：WebRTC 视频轨接线前不创建 MediaPlayer，避免在个别机器上加载闪退；接线后换回 MediaPlayerElement -->
            <Grid x:Name="RemoteVideo">
                <TextBlock Text="等待对方加入…" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <!-- 远端多光标层：每位参与者一个 Ellipse + 名字；光标画在这里不遮挡画面 -->
            <Canvas x:Name="RemoteCursorLayer" IsHitTestVisible="False" />
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Spacing="6">
                <!-- MLS 密钥未建立前不显示 E2EE 徽标 -->
                <InfoBar x:Name="E2eeBadge" Severity="Success" IsOpen="False" Title="E2EE"
                         Message="MLS + SFrame 已启用" />
                <InfoBar x:Name="ControlRequestBar" Severity="Warning" IsOpen="False"
                         Title="对方请求远程控制" Message="允许后对方可以移动你的鼠标、按键。" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="会话" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBox x:Name="SessionCodeBox" Header="会话码" IsReadOnly="True"
                     PlaceholderText="开始分享后生成" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartSharingButton" Content="开始分享" Click="StartSharing_Click" />
                <Button x:Name="StopSharingButton" Content="停止分享" Click="StopSharing_Click" />
            </StackPanel>
            <TextBlock Text="远程控制" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="AllowControlToggle" Header="允许对方远程控制我"
                          Toggled="AllowControlToggle_Toggled" />
            <Button x:Name="RequestControlButton" Content="请求远程控制对方"
                    Click="RequestControl_Click" />
            <TextBlock x:Name="StatusText" Text="等待开始…" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Spacing="6">
                <Button x:Name="CopyInviteLinkButton" Content="复制邀请链接"
                        Click="CopyInviteLink_Click" />
                <Button x:Name="LeaveSessionButton" Content="退出会话"
                        Click="LeaveSession_Click" />
            </StackPanel>
            <!-- 诊断：手动把日志写到文件，方便没有调试器时定位闪退 -->
            <Button x:Name="DumpLogButton" Content="导出诊断日志"
                    Click="DumpLog_Click" />
        </StackPanel>
    </Grid>
</Page>
