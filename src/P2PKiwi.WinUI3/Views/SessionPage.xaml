<Page
    x:Class="P2PKiwi.WinUI3.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid ColumnDefinitions="*,320" Padding="16">
        <!-- 投屏画面：MediaPlayerElement 接 WebRTC 远端视频轨；本地分享时显示采集预览 -->
        <Grid Grid.Column="0" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <MediaPlayerElement x:Name="RemoteVideo" Stretch="Uniform" />
            <!-- 远端多光标层：每个参与者一个带名字的光标 -->
            <Canvas x:Name="CursorLayer" IsHitTestVisible="False" />
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Spacing="6">
                <InfoBar x:Name="E2eeBadge" Severity="Success" IsOpen="True" Title="E2EE"
                         Message="MLS + SFrame 已启用" />
                <InfoBar x:Name="ControlRequestBar" Severity="Warning" IsOpen="False"
                         Title="对方请求远程控制" Message="允许后对方可以移动你的鼠标、按键。"
                         ActionButton="{x:Bind AllowControlButton}" />
            </StackPanel>
            <!-- 底部控制条 -->
            <CommandBar VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                        DefaultLabelPosition="Right" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <AppBarButton x:Name="MicButton" Icon="Microphone" Label="静音" Click="MicButton_Click" />
                <AppBarButton x:Name="ControlButton" Icon="TouchPointer" Label="远程控制" Click="ControlButton_Click" />
                <AppBarButton Icon="Chat" Label="聊天" Click="ChatButton_Click" />
                <AppBarButton Icon="FullScreen" Label="全屏" Click="Fullscreen_Click" />
                <AppBarSeparator />
                <AppBarButton Icon="HangUp" Label="离开" Foreground="Red" Click="Leave_Click" />
            </CommandBar>
        </Grid>

        <!-- 右侧：成员 + 聊天 -->
        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="12">
            <TextBlock Text="成员" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="ParticipantList" SelectionMode="None" MaxHeight="180" />
            <TextBlock Text="聊天" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="ChatList" SelectionMode="None" Height="300" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="ChatInput" PlaceholderText="输入消息…" Width="220"
                         KeyDown="ChatInput_KeyDown" />
                <Button Content="发送" Click="SendChat_Click" />
            </StackPanel>
            <TextBlock Text="提示：聊天与媒体都不经过中心服务器，邀请链接只用来交换连接信息。"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
