<Page
    x:Class="P2PKiwi.WinUI3.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    FontWeight="Bold">
    <Grid Padding="24">
        <controls:TabView IsAddTabButtonVisible="False">
            <!-- 基本：对照原版设置页“基本” -->
            <controls:TabViewItem Header="基本" IsClosable="False">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="12" Width="600" HorizontalAlignment="Left">
                        <TextBox x:Name="UserNameBox" Header="用户名" Text="Kiwi" />
                        <TextBox x:Name="ForegroundBox" Header="前景色" Text="#ffffff"
                                 TextChanged="ForegroundBox_TextChanged" />
                        <Border x:Name="ForegroundPreview" Width="48" Height="24" CornerRadius="4"
                                HorizontalAlignment="Left" Background="White" />
                        <TextBox x:Name="BackgroundBox" Header="背景色（未实现）" Text="#0099ff"
                                 TextChanged="BackgroundBox_TextChanged" IsEnabled="False" />
                        <Border x:Name="BackgroundPreview" Width="48" Height="24" CornerRadius="4"
                                HorizontalAlignment="Left" Background="#0099ff" />
                        <TextBlock Text="背景色暂未实现，改了不生效。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="LanguageBox" Header="语言（未实现）" SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False">
                            <x:String>zh</x:String>
                            <x:String>en</x:String>
                        </ComboBox>
                        <TextBlock Text="语言切换暂未实现，全站目前只有中文。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                        <TextBlock x:Name="BasicSavedHint" Text="已保存" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:TabViewItem>
            <!-- 媒体：对照原版设置页“媒体”，加上本版的画面设置 -->
            <controls:TabViewItem Header="媒体" IsClosable="False">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="12" Width="600" HorizontalAlignment="Left">
                        <ComboBox x:Name="CameraBox" Header="摄像头" HorizontalAlignment="Stretch">
                            <x:String>系统默认</x:String>
                        </ComboBox>
                        <ComboBox x:Name="MicrophoneBox" Header="麦克风" HorizontalAlignment="Stretch">
                            <x:String>系统默认</x:String>
                        </ComboBox>
                        <CheckBox x:Name="MicOnConnectBox" Content="连接时麦克风是否打开" IsChecked="True" />
                        <CheckBox x:Name="RecordBox" Content="录制别人共享给你的屏幕" />
                        <ComboBox x:Name="ResolutionBox" Header="分辨率" HorizontalAlignment="Stretch">
                            <x:String>1280 × 720</x:String>
                            <x:String>1920 × 1080</x:String>
                            <x:String>2560 × 1440</x:String>
                        </ComboBox>
                        <Slider x:Name="FrameRateSlider" Header="帧率" Minimum="15" Maximum="60" Value="30"
                                HorizontalAlignment="Stretch" />
                        <Slider x:Name="BitrateSlider" Header="码率 (Mbps)" Minimum="1" Maximum="20" Value="8"
                                HorizontalAlignment="Stretch" />
                        <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                        <TextBlock x:Name="MediaSavedHint" Text="已保存" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:TabViewItem>
            <!-- 高级：对照原版设置页“高级” -->
            <controls:TabViewItem Header="高级" IsClosable="False">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="12" Width="600" HorizontalAlignment="Left">
                        <CheckBox x:Name="BonjourBox" Content="启用 Bonjour（可选联系人服务器，未实现）" IsEnabled="False" />
                        <TextBox x:Name="BonjourUrlBox" Header="Bonjour 服务器 URL（未实现）"
                                 Text="https://bonjour.p2p.kiwi" IsEnabled="False" />
                        <CheckBox x:Name="DebugLogBox" Content="启用调试日志（未实现）" IsEnabled="False" />
                        <CheckBox x:Name="E2eeBox" Content="端到端加密" IsChecked="True" />
                        <CheckBox x:Name="SFrameBox" Content="加密媒体（SFrame）" IsChecked="True" />
                        <TextBox x:Name="StunTurnBox" Header="STUN/TURN 服务器（每行一个地址或 JSON 对象）"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
                        <TextBlock x:Name="StunTurnHint" Visibility="Collapsed"
                                   Text="解析失败，已用默认 STUN 服务器（stun:stun.l.google.com:19302）。请检查格式：每行一个 stun:/turn:/turns: 地址，或一个 JSON 对象。"
                                   TextWrapping="Wrap" FontSize="12" Foreground="OrangeRed" />
                        <TextBlock Text="STUN / TURN 只交换 ICE 连通信息，不转发聊天与媒体密钥。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                        <TextBlock x:Name="AdvancedSavedHint" Text="已保存" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:TabViewItem>
        </controls:TabView>
    </Grid>
</Page>
