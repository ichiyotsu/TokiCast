<Page
    x:Class="P2PKiwi.WinUI3.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    FontWeight="Bold">
    <ScrollViewer Padding="24">
        <!-- 内容定宽 760 左对齐：只写 MaxWidth 会让面板按内容收窄；定死宽度才撑满 -->
        <StackPanel Spacing="16" Width="760" HorizontalAlignment="Left">
            <!-- 发起 -->
            <controls:Expander Header="发起投屏" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <!-- 要分享的显示器/窗口在点「开始分享」后由系统选择器选，不在这里选。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="ShareAudioCheck" Content="同时分享系统声音（未实现）" IsChecked="True" IsEnabled="False" />
                        <CheckBox x:Name="AllowControlCheck" Content="允许对方远程控制（未实现）" IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="开始分享" Style="{StaticResource AccentButtonStyle}"
                                Click="StartSharing_Click" />
                        <Button x:Name="CopyLinkButton" Content="复制链接" IsEnabled="False"
                                Click="CopyLink_Click" />
                    </StackPanel>
                    <!-- 主持方：对方发回的 answer 链接，粘贴后点「允许加入」才接通 -->
                    <TextBox x:Name="AnswerLinkBox" Header="对方发回的 answer 链接"
                             PlaceholderText="粘贴加入方发回的 answer 链接…" TextWrapping="Wrap" />
                    <Button Content="允许加入" Click="AllowJoin_Click" />
                    <TextBlock Text="开始分享后把邀请链接发给对方；对方加入后会把 answer 链接发回，粘贴到这里点「允许加入」即可接通（无中心服务器，只能这样两步交换）。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </controls:Expander>

            <!-- 加入 -->
            <controls:Expander Header="加入会话" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <TextBox x:Name="JoinLinkBox" Header="邀请链接"
                             PlaceholderText="https://p2p.kiwi/session/…" />
                    <TextBlock Text="请贴主持人发的完整邀请链接（房间码是链接里 session/ 后面的 8 位字符）。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="加入" Click="Join_Click" />
                </StackPanel>
            </controls:Expander>

            <TextBlock Text="最近会话" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,8">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
