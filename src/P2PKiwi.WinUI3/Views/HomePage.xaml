<Page
    x:Class="P2PKiwi.WinUI3.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer Padding="24">
        <!-- 内容定宽 760 左对齐：只写 MaxWidth 会让面板按内容收窄；定死宽度才撑满 -->
        <StackPanel Spacing="16" Width="760" HorizontalAlignment="Left">
            <TextBlock Text="无需账号，点对点直连。" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="分享屏幕、语音与聊天都走 WebRTC 直连，不经过中心云。端到端加密由 MLS + SFrame 提供，STUN / TURN 只用来打通网络。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- 发起 -->
            <controls:Expander Header="发起投屏" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <ComboBox x:Name="SourcePicker" Header="分享内容" HorizontalAlignment="Stretch"
                              PlaceholderText="选择显示器或窗口…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="ShareAudioCheck" Content="同时分享系统声音" IsChecked="True" />
                        <CheckBox x:Name="AllowControlCheck" Content="允许对方远程控制" IsChecked="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="开始分享" Style="{StaticResource AccentButtonStyle}"
                                Click="StartSharing_Click" />
                        <Button x:Name="CopyLinkButton" Content="复制链接" IsEnabled="False"
                                Click="CopyLink_Click" />
                    </StackPanel>
                    <InfoBar x:Name="E2eeBar" Severity="Success" IsOpen="False"
                             Title="端到端加密已启用" Message="MLS 密钥已建立，媒体帧经 SFrame 加密。" />
                </StackPanel>
            </controls:Expander>

            <!-- 加入 -->
            <controls:Expander Header="加入会话" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <TextBox x:Name="JoinLinkBox" Header="邀请链接或房间码"
                             PlaceholderText="https://p2p.kiwi/session/… 或 8 位房间码" />
                    <TextBlock Text="房间码就是邀请链接里 session/ 后面的 8 位字符，贴完整链接或只贴码都可以。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="加入" Click="Join_Click" />
                </StackPanel>
            </controls:Expander>

            <TextBlock Text="最近会话" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,8">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
