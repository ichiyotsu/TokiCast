<Window
    x:Class="P2PKiwi.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="TokiCast">
    <Grid>
        <!-- 左边栏宽度按 Tokilive 的 WinUI 设计：展开 200 / 收起 48 -->
        <controls:NavigationView x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            OpenPaneLength="200"
            CompactPaneLength="48"
            FontWeight="Bold"
            SelectionChanged="NavView_SelectionChanged">
            <controls:NavigationView.PaneHeader>
                <TextBlock Text="TokiCast" FontSize="20" FontWeight="Bold" Margin="16,12,0,8" />
            </controls:NavigationView.PaneHeader>
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="主页" Tag="home" Icon="Home" />
                <controls:NavigationViewItem Content="会话" Tag="session" Icon="Video" />
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource TitleTextBlockStyle}" />
                </DataTemplate>
            </controls:NavigationView.HeaderTemplate>
            <Frame x:Name="ContentFrame" />
        </controls:NavigationView>
    </Grid>
</Window>
