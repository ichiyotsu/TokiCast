<!-- TokiUI Windows 变体 token（0.2.0-b1 语义标准，WinUI 3 落地） -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 品牌种子 #6750A4；WinUI 3 Accent 由系统主题接管，这里只定产品层 token -->
    <Color x:Key="TokiBrandSeed">#6750A4</Color>
    <SolidColorBrush x:Key="TokiBrandBrush" Color="{StaticResource TokiBrandSeed}" />
    <SolidColorBrush x:Key="TokiKiwiBrush" Color="#7AC74F" />
    <!-- 圆角：WinUI 3 默认 8，卡片 12，胶囊 999 -->
    <CornerRadius x:Key="TokiCornerCard">12,12,12,12</CornerRadius>
    <CornerRadius x:Key="TokiCornerControl">8,8,8,8</CornerRadius>
    <!-- 字体：Inter（打包进应用）优先，中文回退微软雅黑；全站粗体 -->
    <FontFamily x:Key="TokiFontFamily">ms-appx:///Assets/Fonts/Inter-Bold.ttf#Inter, Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
